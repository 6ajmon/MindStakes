[resource]
script = ExtResource("2_vfj35")
QuestionText = "Jakim rodzajem statku żaglowego był Szkocki Michał, zwany również Great Michael?"
AnswersText = Array[String](["karaka", "galeon", "bryg", "fregata"])
Category = ExtResource("1_1ju6f")
FunFact = "był zbudowany z myślą o krucjacie przeciw Imperium osmańskiemu. Plany związane z \"Michaelem\" uległy zmianie, gdy rozpoczęły się Wojny włoskie – na mocy Sojuszu z Auld Szkocja była zobowiązana prowadzić działania przeciwko Anglii."
