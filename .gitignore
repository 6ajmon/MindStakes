# Godot 4+ specific ignores
.godot/
/android/

# C# / .NET build output
**/bin/
**/obj/

# Debug/release symbols
*.pdb

# Export/build artifacts
export/
build/
releases/
dist/
out/
Exports/

# Image assets are local-only.
Assets/Images/*

# IDE/Editor
.vs/
.vscode/
.idea/
*.sln.iml

*.csproj.user
*.user

# Question data is kept outside the repository (see "Question data" in README.md).
# Only the sample pool stays tracked so the project runs from a fresh clone.
Resources/Questions/Pool*/*
!Resources/Questions/Pool1/1.tres
!Resources/Questions/Pool1/2.tres